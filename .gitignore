# Python (apps/web/api - FastAPI backend, co-located for Vercel's Root Directory requirement)
apps/web/api/.venv/
apps/web/.venv/
**/__pycache__/
*.pyc

# Node
node_modules/

# Vercel
.vercel/
.env*.local

# Env files
.env
.env.local

# Model artifacts (large binary files - see docs/agents/domain.md for versioning approach)
apps/web/api/_app/artifacts/*.joblib
apps/web/api/_app/artifacts/*.txt
!apps/web/api/_app/artifacts/.gitkeep

# Data (raw dataset not committed - documented in docs/data_assumptions.md)
data/raw/

# OS
.DS_Store
Thumbs.db
